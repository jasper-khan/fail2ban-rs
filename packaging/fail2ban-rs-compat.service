[Unit]
Description=Fail2Ban 1.1.1 Compatible Service (fail2ban-rs)
Documentation=https://github.com/jasper-khan/fail2ban-rs
After=network.target iptables.service firewalld.service nftables.service
PartOf=iptables.service firewalld.service nftables.service

[Service]
Type=simple
RuntimeDirectory=fail2ban
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/fail2ban-rs run \
    --legacy-dir /etc/fail2ban \
    --legacy-execute-actions \
    --legacy-sqlite-rw \
    --legacy-socket /run/fail2ban/fail2ban.sock
ExecReload=/usr/local/bin/fail2ban-rs client -s /run/fail2ban/fail2ban.sock reload
ExecStop=/usr/local/bin/fail2ban-rs client -s /run/fail2ban/fail2ban.sock stop
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
